{
  "expo": {
    "name": "Sportalsó",
    "slug": "sportalso",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hu.sportalso.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCalendarsWriteOnlyAccessDescription": "A koncertek naptárba mentéséhez.",
        "NSCalendarsFullAccessDescription": "A koncertek naptárba mentéséhez.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "hu.sportalso.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1a7f37",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-calendar",
        {
          "calendarPermission": "A koncertek naptárba mentéséhez."
        }
      ],
      [
        "expo-document-picker",
        {
          "writePermission": true
        }
      ]
    ]
  }
}
